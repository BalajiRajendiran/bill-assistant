{
  // IPv6 is black-holed on this machine and .NET tries it before IPv4, so NuGet restore fails
  // with "The SSL connection could not be established / Broken pipe" (see CLAUDE.md).
  // This covers the integrated terminal; tasks.json and launch.json set it themselves. It does
  // NOT reach C# Dev Kit's own background restore - for that, put the variable in ~/.zshrc.
  "terminal.integrated.env.osx": {
    "DOTNET_SYSTEM_NET_DISABLEIPV6": "1"
  },

  "dotnet.defaultSolution": "api/BillAssistant.slnx",

  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.angular": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/bin": true,
    "**/obj": true
  },

  "[csharp]": {
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.formatOnSave": true
  }
}
