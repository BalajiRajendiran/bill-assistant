{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "services: up",
      "detail": "Start Qdrant (and check Ollama is reachable)",
      "type": "shell",
      "command": "docker compose up -d && curl -sf http://localhost:11434/api/tags > /dev/null && echo 'Ollama OK' || echo 'Ollama is NOT running - start it before using the API'",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "services: down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "api: build",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/api/BillAssistant.slnx"],
      "options": { "env": { "DOTNET_SYSTEM_NET_DISABLEIPV6": "1" } },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: stop",
      "detail": "Free port 5280 when a previous debug session is still holding it",
      "type": "shell",
      "command": "lsof -tnP -iTCP:5280 -sTCP:LISTEN | xargs -r kill 2>/dev/null; sleep 1; lsof -nP -iTCP:5280 -sTCP:LISTEN >/dev/null 2>&1 && echo 'still in use' || echo 'port 5280 is free'",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "api: prepare",
      "detail": "Free port 5280, then build. Used by the API launch config so F5 always works.",
      "dependsOrder": "sequence",
      "dependsOn": ["api: stop", "api: build"],
      "problemMatcher": []
    },
    {
      "label": "api: test",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/api/BillAssistant.slnx"],
      "options": { "env": { "DOTNET_SYSTEM_NET_DISABLEIPV6": "1" } },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: test (integration)",
      "detail": "Needs Ollama and Qdrant running",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/api/BillAssistant.slnx", "--filter", "Category=Integration"],
      "options": { "env": { "DOTNET_SYSTEM_NET_DISABLEIPV6": "1", "BILLS_INTEGRATION": "1" } },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: install",
      "detail": "npm 11.4 needs --legacy-peer-deps for the vitest peer graph",
      "type": "shell",
      "command": "npm install --legacy-peer-deps",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "web: serve",
      "detail": "ng serve on :4200, proxying /api to the API on :5280",
      "type": "shell",
      "command": "npx ng serve",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "ng",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.|Changes detected",
          "endsPattern": "Application bundle generation complete|Watch mode enabled"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "web: test",
      "type": "shell",
      "command": "npx ng test --watch=false",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "samples: ingest",
      "detail": "Upload every PDF in samples/ to a running API",
      "type": "shell",
      "command": "for f in samples/*.pdf; do echo \"uploading $f\"; curl -s -F \"file=@$f\" http://localhost:5280/api/bills > /dev/null; done; echo 'done'",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "samples: regenerate",
      "type": "shell",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tools/SampleBillGenerator", "--", "${workspaceFolder}/samples"],
      "options": { "env": { "DOTNET_SYSTEM_NET_DISABLEIPV6": "1" } },
      "problemMatcher": []
    }
  ]
}
