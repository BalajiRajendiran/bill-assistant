{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: prepare",
      "program": "${workspaceFolder}/api/BillAssistant.Api/bin/Debug/net10.0/BillAssistant.Api.dll",
      "args": ["--urls", "http://localhost:5280"],
      "cwd": "${workspaceFolder}/api/BillAssistant.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_SYSTEM_NET_DISABLEIPV6": "1"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar"
      }
    },
    {
      "name": "API (no browser)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: prepare",
      "program": "${workspaceFolder}/api/BillAssistant.Api/bin/Debug/net10.0/BillAssistant.Api.dll",
      "args": ["--urls", "http://localhost:5280"],
      "cwd": "${workspaceFolder}/api/BillAssistant.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_SYSTEM_NET_DISABLEIPV6": "1"
      }
    },
    {
      "name": "Web",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web: serve",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true
    },
    {
      "name": "Web (server already running)",
      "detail": "Use when ng serve is already up - skips the preLaunchTask entirely",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "API + Web",
      "configurations": ["API (no browser)", "Web"],
      "stopAll": true,
      "presentation": { "order": 1 }
    }
  ]
}
